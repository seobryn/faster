{
  "name": "@seobryn/faster",
  "displayName": "Faster Web Framework",
  "version": "2.0.0",
  "description": "Super fast Web framework for Node.js to create api and microservices",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "NODE_NO_WARNINGS=1 tsx watch ./examples/server.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "commit": "node scripts/commit.mjs",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix"
  },
  "engines": {
    "node": ">= v18.19.0"
  },
  "keywords": [
    "faster",
    "web",
    "app",
    "http",
    "application",
    "server",
    "framework",
    "middleware"
  ],
  "author": {
    "name": "Jose Joya",
    "email": "ing.jose.joya@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:seobryn/faster.git"
  },
  "readmeFilename": "README.md",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/seobryn/faster/issues"
  },
  "homepage": "https://github.com/seobryn/faster",
  "devDependencies": {
    "@types/node": "^22.13.13",
    "@vitest/coverage-v8": "^3.0.9",
    "eslint": "^9.23.0",
    "@eslint/js": "^9.23.0",
    "globals": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "@typescript-eslint/parser": "^7.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "typescript-eslint": "^7.0.0",
    "nodemon": "3.1.4",
    "prettier": "^3.5.3",
    "standard": "17.1.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.3",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.0.9"
  }
}